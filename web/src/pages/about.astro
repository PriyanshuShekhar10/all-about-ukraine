---
import Base from "@/layouts/Base.astro";
import { wikiCounts, getCategories } from "@/lib/wiki";

const categories = getCategories();
const description =
  "About this encyclopedia of Ukraine — what it covers, where the material comes from, and how the cross-linked entries are built.";
---

<Base title="About" description={description}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>About</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        About
      </h1>
      <p class="mt-2 max-w-prose text-body">
        A cross-referenced reference work devoted entirely to Ukraine.
      </p>
    </header>

    <div class="mt-6 flex max-w-prose flex-col gap-4 text-body">
      <p>
        This is a plain, encyclopedia-style guide to Ukraine — its land, history,
        people, culture, economy, and the ongoing Russia–Ukraine War. It currently
        holds <strong class="text-ink">{wikiCounts.pages}</strong> entries across
        {categories.length} categories. Wherever a notable term first appears on a
        page, it links to its own entry, so you can read your way across the whole
        subject the way you would in a traditional reference book.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">What it covers</h2>
      <p>
        Everything here is about Ukraine. Topics that cross borders are included
        only where they bear directly on Ukraine's story. The categories are:
      </p>
      <ul class="list-disc space-y-1 pl-5 marker:text-mute">
        {
          categories.map((cat) => (
            <li>
              <a href={`/wiki/category/${cat.slug}`} class="doclink">
                {cat.name}
              </a>{" "}
              — {cat.blurb}
            </li>
          ))
        }
      </ul>

      <h2 class="mt-4 text-xl font-bold text-ink">How entries are built</h2>
      <p>
        Entries are compiled from publicly available reference material and
        summarized into a consistent, readable format, then automatically
        cross-linked into a single web of articles. The aim is a calm, low-glare
        reading experience without clutter.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">Accuracy &amp; corrections</h2>
      <p>
        We work to keep entries accurate, but this is a summarized reference and
        may contain errors or omissions. Nothing here is legal, financial, or
        professional advice. If you spot a mistake, please
        <a href="/contact" class="doclink">let us know</a>.
      </p>

      <h2 class="mt-4 text-xl font-bold text-ink">Independence</h2>
      <p>
        This project is independent. It is not affiliated with, endorsed by, or
        sponsored by any government, encyclopedia, publisher, or organization
        mentioned in its entries.
      </p>
    </div>

    <p class="ui mt-8 text-sm text-mute">
      Related: <a href="/faq" class="doclink">FAQ</a> ·
      <a href="/contact" class="doclink">Contact</a> ·
      <a href="/wiki/a-z" class="doclink">A–Z index</a>
    </p>
  </div>
</Base>
