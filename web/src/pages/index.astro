---
import Base from "@/layouts/Base.astro";
import { getCategories, wikiCounts, displayTitle } from "@/lib/wiki";

const categories = getCategories();

const site = "https://ukraineporn.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Ukraine Encyclopedia",
  alternateName: "ukraineporn.com",
  url: `${site}/`,
  description: "No fantasies. Just centuries of Ukraine’s story, uncensored.",
  inLanguage: "en",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${site}/wiki/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="ukraineporn.com"
  description="No fantasies. Just centuries of Ukraine’s story, uncensored."
  jsonLd={jsonLd}
>
  <div class="doc mx-auto max-w-[820px] px-5 py-10 sm:py-12">
    <header>
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        No fantasies. Just centuries of Ukraine’s story, uncensored.
      </h1>
      <p class="mt-4 text-body">
        A cross-referenced reference work on Ukraine — its land, history, people,
        culture, economy, and the ongoing war. Terms shown as links open their
        own entry; the same term is linked wherever it first appears on a page.
      </p>
      <p class="ui mt-3 text-sm text-mute">
        {wikiCounts.pages} entries in {categories.length} categories. See the{" "}
        <a href="/wiki/a-z" class="doclink">A–Z index</a> or
        <a href="/wiki/search" class="doclink">search</a>.
      </p>
    </header>

    <hr class="my-8 border-hairline" />

    <div class="flex flex-col gap-9">
      {
        categories.map((cat) => (
          <section>
            <h2 class="text-xl font-bold text-ink">
              <a href={`/wiki/category/${cat.slug}`} class="doclink">
                {cat.name}
              </a>
              <span class="ui ml-2 align-middle text-xs font-normal text-mute">
                ({cat.entries.length})
              </span>
            </h2>
            <p class="mt-1 text-[15px] text-body">{cat.blurb}</p>
            <ul class="mt-3 columns-1 gap-8 text-[15px] sm:columns-2 [column-fill:balance]">
              {cat.entries.map((e) => (
                <li class="mb-1 break-inside-avoid">
                  <a href={`/wiki/${e.slug}`} class="doclink">
                    {displayTitle(e.title)}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</Base>
