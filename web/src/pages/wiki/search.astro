---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Search"
  description="Search the Ukraine encyclopedia."
  noindex={true}
>
  <div class="doc mx-auto max-w-[760px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>Search</span>
    </nav>

    <header class="mb-6 border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        Search
      </h1>
      <p class="mt-2 text-body">
        Full-text search across every entry in the encyclopedia.
      </p>
    </header>

    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <div id="search" class="pf"></div>
    <noscript>
      <p class="text-body">Search requires JavaScript. Try the
        <a href="/wiki/a-z" class="text-link underline">A–Z index</a> instead.</p>
    </noscript>

    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", () => {
        if (typeof PagefindUI === "undefined") return;
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          resetStyles: false,
        });
        // Prefill from ?q= so shared/search-action links run the query.
        try {
          var q = new URLSearchParams(location.search).get("q");
          if (q) {
            var input = document.querySelector(
              "#search input[type='text'], #search .pagefind-ui__search-input",
            );
            if (input) {
              input.value = q;
              input.dispatchEvent(new Event("input", { bubbles: true }));
            }
          }
        } catch (e) {}
      });
    </script>
  </div>
</Base>

<style is:global>
  /* Blend the Pagefind default UI into the site's design tokens. */
  .pf {
    --pagefind-ui-primary: var(--color-ink);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-canvas);
    --pagefind-ui-border: var(--color-hairline);
    --pagefind-ui-tag: var(--color-canvas-soft-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-sans);
  }
</style>
