---
import Base from "@/layouts/Base.astro";
import {
  getCategories,
  getCategory,
  stripWikitext,
  displayTitle,
} from "@/lib/wiki";

export function getStaticPaths() {
  return getCategories().map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const category = getCategory(slug!);
if (!category) {
  return Astro.redirect("/404");
}

const homeUrl = new URL("/", Astro.site).href;
const categoryUrl = new URL(`/wiki/category/${category.slug}`, Astro.site).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: category.name,
    description: category.blurb,
    url: categoryUrl,
    inLanguage: "en",
    hasPart: category.entries.map((e) => ({
      "@type": "Article",
      headline: displayTitle(e.title),
      url: new URL(`/wiki/${e.slug}`, Astro.site).href,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      {
        "@type": "ListItem",
        position: 2,
        name: category.name,
        item: categoryUrl,
      },
    ],
  },
];
---

<Base title={category.name} description={category.blurb} jsonLd={jsonLd}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>{category.name}</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        {category.name}
      </h1>
      <p class="mt-2 text-body">{category.blurb}</p>
      <p class="ui mt-1 text-sm text-mute">{category.entries.length} entries</p>
    </header>

    <ul class="mt-6 flex flex-col gap-4">
      {
        category.entries.map((e) => (
          <li>
            <a href={`/wiki/${e.slug}`} class="doclink text-lg font-bold">
              {displayTitle(e.title)}
            </a>
            <p class="mt-0.5 text-[15px] leading-relaxed text-body">
              {stripWikitext(e.summary)}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
