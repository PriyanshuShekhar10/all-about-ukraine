---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" noindex={true}>
  <div class="doc mx-auto max-w-[820px] px-5 py-16 sm:py-24">
    <p class="ui text-sm text-mute">Error 404</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight text-ink sm:text-4xl">
      This page could not be found.
    </h1>
    <p class="mt-4 max-w-prose text-body">
      The page you are looking for doesn&rsquo;t exist or may have moved. Try the
      <a href="/wiki/a-z" class="doclink">A–Z index</a>,
      <a href="/wiki/search" class="doclink">search</a>, or go back
      <a href="/" class="doclink">home</a>.
    </p>
  </div>
</Base>
