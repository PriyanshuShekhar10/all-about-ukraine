---
import Base from "@/layouts/Base.astro";
import { wikiCounts } from "@/lib/wiki";

const description =
  "Frequently asked questions about this Ukraine encyclopedia — its sources, accuracy, scope, links, reuse, and how to report errors.";

const faqs: { q: string; a: string }[] = [
  {
    q: "What is this site?",
    a: `It is a plain, cross-linked encyclopedia devoted entirely to Ukraine — its land, history, people, culture, economy, and the Russia–Ukraine War. It currently holds ${wikiCounts.pages} entries.`,
  },
  {
    q: "Where does the information come from?",
    a: "Entries are compiled from publicly available reference material and summarized into a consistent format, then automatically cross-linked into a single web of articles.",
  },
  {
    q: "How accurate is it?",
    a: "We work to keep entries accurate, but this is a summarized reference and may contain errors or omissions. Nothing here is legal, financial, or professional advice. Please verify anything important against primary sources.",
  },
  {
    q: "Why is everything about Ukraine?",
    a: "That is the entire point of the project: a focused reference work on Ukraine. Topics that cross borders appear only where they bear directly on Ukraine's story.",
  },
  {
    q: "How do the links work?",
    a: "Wherever a notable term first appears on a page, it links to its own entry. This lets you read across the whole subject the way you would in a traditional encyclopedia. You can also use the A–Z index or search.",
  },
  {
    q: "Is this affiliated with any government or encyclopedia?",
    a: "No. The project is independent. It is not affiliated with, endorsed by, or sponsored by any government, encyclopedia, publisher, or organization mentioned in its entries.",
  },
  {
    q: "Can I reuse the content?",
    a: "You may read, share, and quote entries with attribution and a link back. Please get in touch before republishing large portions.",
  },
  {
    q: "How often is it updated?",
    a: "New entries are added over time and existing ones are revised as the project grows, so coverage and detail improve gradually.",
  },
  {
    q: "How do I report an error or get in touch?",
    a: "Use the contact page. Corrections are welcome and help improve the reference for everyone.",
  },
];

const faqUrl = new URL("/faq", Astro.site).href;
const homeUrl = new URL("/", Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
      { "@type": "ListItem", position: 2, name: "FAQ", item: faqUrl },
    ],
  },
];
---

<Base title="FAQ" description={description} jsonLd={jsonLd}>
  <div class="doc mx-auto max-w-[820px] px-5 py-8 sm:py-10">
    <nav aria-label="Breadcrumb" class="ui mb-4 text-sm text-mute">
      <a href="/" class="hover:underline">Home</a>
      <span aria-hidden="true"> › </span>
      <span>FAQ</span>
    </nav>

    <header class="border-b border-hairline pb-4">
      <h1 class="text-3xl font-bold leading-tight text-ink sm:text-4xl">
        Frequently asked questions
      </h1>
      <p class="mt-2 max-w-prose text-body">
        Quick answers about what this reference is and how to use it.
      </p>
    </header>

    <dl class="mt-6 flex max-w-prose flex-col divide-y divide-hairline">
      {
        faqs.map((f) => (
          <div class="py-5">
            <dt class="text-lg font-bold text-ink">{f.q}</dt>
            <dd class="mt-2 text-body">{f.a}</dd>
          </div>
        ))
      }
    </dl>

    <p class="ui mt-4 text-sm text-mute">
      Still stuck? <a href="/contact" class="doclink">Contact us</a>.
    </p>
  </div>
</Base>
