---
import { getCategories, wikiCounts } from "@/lib/wiki";
const categories = getCategories();
const year = new Date().getFullYear();

const siteLinks = [
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
];
const legalLinks = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms & Conditions" },
];
const exploreLinks = [
  { href: "/wiki/a-z", label: "A–Z index" },
  { href: "/wiki/graph", label: "Knowledge graph" },
  { href: "/wiki/search", label: "Search" },
];
---

<footer class="ui mt-12 border-t border-hairline bg-canvas">
  <div class="mx-auto max-w-[820px] px-5 py-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <nav aria-label="Explore">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-mute">
          Explore
        </h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            exploreLinks.map((link) => (
              <li>
                <a href={link.href} class="doclink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Site">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-mute">
          Site
        </h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            siteLinks.map((link) => (
              <li>
                <a href={link.href} class="doclink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-mute">
          Legal
        </h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href} class="doclink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Categories">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-mute">
          Categories
        </h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          {
            categories.map((cat) => (
              <li>
                <a href={`/wiki/category/${cat.slug}`} class="doclink">
                  {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="mt-8 border-t border-hairline pt-6 text-xs leading-relaxed text-mute">
      No fantasies. Just centuries of Ukraine’s story, uncensored. {
        wikiCounts.pages
      } entries. &copy; {year}.
    </p>
  </div>
</footer>
