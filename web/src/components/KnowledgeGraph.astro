---
import type { KnowledgeGraph as KG } from "@/lib/wiki";
import { CATEGORY_META, CATEGORY_ORDER } from "@/lib/wiki";

interface Props {
  data: KG;
  /** Highlight this node (local graph on an article). */
  focus?: string;
  /** Canvas height in CSS pixels. */
  height?: number;
  /** Compact chrome for embedding on article pages. */
  compact?: boolean;
}

const { data, focus, height = 560, compact = false } = Astro.props;

const legend = CATEGORY_ORDER.filter((slug) =>
  data.nodes.some((n) => n.category === slug),
).map((slug) => ({
  slug,
  name: CATEGORY_META[slug]?.name ?? slug,
}));

const ranked = [...data.nodes]
  .sort((a, b) => b.degree - a.degree || a.title.localeCompare(b.title))
  .slice(0, 40);

const payload = {
  nodes: data.nodes,
  edges: data.edges,
  focus: focus ?? null,
  compact,
};
---

<figure
  class:list={["knowledge-graph", compact && "knowledge-graph--compact"]}
  data-kg-root
  style={`--kg-h: ${height}px`}
>
  {
    !compact && (
      <div class="ui mb-3 flex flex-wrap items-center justify-between gap-3 text-sm">
        <p class="text-mute">
          {data.nodes.length} entries · {data.edges.length} links. Drag the
          background to pan, scroll to zoom, drag a node to move it, click to
          open.
        </p>
        <label class="flex items-center gap-2 text-body">
          <span class="sr-only">Find an entry</span>
          <input
            type="search"
            data-kg-filter
            placeholder="Find an entry…"
            autocomplete="off"
            class="w-44 border border-hairline bg-canvas px-2 py-1 text-sm text-ink placeholder:text-mute focus:outline-none focus-visible:ring-2 focus-visible:ring-link sm:w-56"
          />
        </label>
      </div>
    )
  }

  <div
    class:list={[
      "kg-stage",
      !compact && "flex flex-col gap-4 lg:flex-row lg:items-stretch",
    ]}
  >
    <div
      class:list={[
        "relative min-w-0 flex-1 overflow-hidden border border-hairline bg-canvas-soft",
        !compact && "lg:min-h-0",
      ]}
      style="height: var(--kg-h)"
      data-kg-viewport
    >
      <div data-kg-mount class="size-full" aria-label="Knowledge graph"></div>
      <p
        data-kg-hint
        class="ui pointer-events-none absolute bottom-2 left-2 z-10 max-w-[75%] truncate rounded-sm bg-canvas/90 px-2 py-1 text-xs text-mute"
        aria-live="polite"
      >
      </p>
    </div>

    {
      !compact && ranked.length > 0 && (
        <aside
          class="ui flex w-full shrink-0 flex-col border border-hairline bg-canvas lg:w-64"
          aria-label="Most connected entries"
          style="max-height: var(--kg-h)"
        >
          <div class="border-b border-hairline px-3 py-2">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-mute">
              Most connected
            </h2>
            <p class="mt-0.5 text-[11px] text-mute">
              Ranked by number of cross-links
            </p>
          </div>
          <ol
            class="m-0 min-h-0 flex-1 list-none overflow-y-auto p-0"
            data-kg-ranklist
          >
            {ranked.map((n, i) => (
              <li class="border-b border-hairline last:border-b-0">
                <button
                  type="button"
                  data-kg-goto={n.id}
                  class="flex w-full items-baseline gap-2 px-3 py-2 text-left hover:bg-canvas-soft"
                >
                  <span class="w-5 shrink-0 tabular-nums text-xs text-mute">
                    {i + 1}
                  </span>
                  <span class="min-w-0 flex-1 truncate text-sm text-ink">
                    {n.title}
                  </span>
                  <span class="shrink-0 tabular-nums text-xs text-mute">
                    {n.degree}
                  </span>
                </button>
              </li>
            ))}
          </ol>
          <p class="border-t border-hairline px-3 py-2 text-[11px] text-mute">
            Click a name to focus it on the map. Open the entry from the graph,
            or via the
            <a href="/wiki/a-z" class="doclink">
              A–Z index
            </a>
            .
          </p>
        </aside>
      )
    }
  </div>

  {
    legend.length > 0 && (
      <figcaption class="ui mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-mute">
        {legend.map((item) => (
          <span class="inline-flex items-center gap-1.5">
            <span
              class="inline-block size-2.5 shrink-0 border border-hairline"
              data-kg-swatch={item.slug}
              aria-hidden="true"
            />
            {item.name}
          </span>
        ))}
      </figcaption>
    )
  }

  <script
    type="application/json"
    data-kg-json
    is:inline
    set:html={JSON.stringify(payload).replace(/</g, "\\u003c")}
  />
</figure>

<style>
  .knowledge-graph--compact {
    --kg-h: 300px;
  }
  @media (min-width: 640px) {
    .knowledge-graph:not(.knowledge-graph--compact) {
      --kg-h: 680px;
    }
  }
  [data-kg-swatch="geography"] {
    background: #6b7f9a;
  }
  [data-kg-swatch="history"] {
    background: #8a7360;
  }
  [data-kg-swatch="war"] {
    background: #8f5e5a;
  }
  [data-kg-swatch="politics"] {
    background: #6f6b8a;
  }
  [data-kg-swatch="people"] {
    background: #5f7a72;
  }
  [data-kg-swatch="culture"] {
    background: #8a7a52;
  }
  [data-kg-swatch="economy"] {
    background: #5f7a5f;
  }
  [data-kg-swatch="other"] {
    background: #7a7a7a;
  }
  :global(.dark) [data-kg-swatch="geography"] {
    background: #8fa3bc;
  }
  :global(.dark) [data-kg-swatch="history"] {
    background: #b39a84;
  }
  :global(.dark) [data-kg-swatch="war"] {
    background: #b88884;
  }
  :global(.dark) [data-kg-swatch="politics"] {
    background: #9a96b4;
  }
  :global(.dark) [data-kg-swatch="people"] {
    background: #88a49c;
  }
  :global(.dark) [data-kg-swatch="culture"] {
    background: #b4a474;
  }
  :global(.dark) [data-kg-swatch="economy"] {
    background: #88a488;
  }
  :global(.dark) [data-kg-swatch="other"] {
    background: #9a9a9a;
  }
</style>

<script>
  import { initKnowledgeGraphs } from "@/scripts/knowledge-graph";

  initKnowledgeGraphs();
  document.addEventListener("astro:page-load", initKnowledgeGraphs);
</script>
