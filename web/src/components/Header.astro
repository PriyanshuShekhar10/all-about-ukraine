---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

import ThemeToggle from "@/components/ThemeToggle.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/wiki/a-z", label: "A–Z index" },
  { href: "/wiki/search", label: "Search" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
];
---

<header class="border-b border-hairline bg-canvas">
  <div
    class="mx-auto flex max-w-[820px] flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-5 py-3"
  >
    <a href="/" aria-label="Home" class="inline-flex items-center">
      <svg
        width="30"
        height="30"
        viewBox="0 0 32 32"
        role="img"
        aria-hidden="true"
        class="block border border-hairline"
      >
        <rect width="32" height="16" fill="#0057b7"></rect>
        <rect y="16" width="32" height="16" fill="#ffd700"></rect>
      </svg>
    </a>

    <nav aria-label="Primary" class="ui flex items-center gap-4 text-sm">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "underline-offset-2 hover:underline",
              isActive(link.href) ? "font-semibold text-ink" : "text-body",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
